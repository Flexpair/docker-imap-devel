#!/bin/bash

set -e

DEBUG_ADDRESS="debug@${MAILNAME}"
DEBUG_PASS="debug"
MAIL_LOCATION='/var/mail'
POSTMASTER_ADDRESS="postmaster@${MAILNAME}"
HOSTNAME="$(hostname -f)"

_add_line() {
    local line="$1"
    local file="$2"
    if ! grep -Fqx -- "$line" "$file"; then
        printf '%s\n' "$line" >> "$file"
    fi
}

_log() {
    local logfile=/var/log/mail.log
    if [ ! -f $logfile ]; then
        touch $logfile
        chown syslog:adm $logfile
        chmod 640 $logfile
    fi
    echo "$(date '+%b %e %H:%I:%S') $(hostname) entrypoint[$$]: $1" >> $logfile
}

_stop() {
    /etc/init.d/postfix stop
    /etc/init.d/rsyslog stop
    if [ -f /var/run/dovecot/master.pid ]; then
        kill -15 $(cat /var/run/dovecot/master.pid)
        rm -rf /var/run/dovecot/master.pid
    fi
    _log "Docker entrypoint stop"
}

_account_add() {
    local login="$1"
    local password="$2"
    local user="${login%@*}"
    local domain="${login#*@}"

    # These values become passwd-file fields and mailbox path components.
    # Reject separators and traversal components before using them in either.
    if [[ "$login" != *@* || "$domain" == *@* \
        || ! "$user" =~ ^[a-zA-Z0-9._+-]+$ \
        || ! "$domain" =~ ^[a-zA-Z0-9.-]+$ \
        || "$user" == . || "$user" == .. \
        || "$domain" == . || "$domain" == .. ]]; then
        _log "Invalid mailbox address; use a simple local-part@domain address"
        return 1
    fi

    if [ -z "$password" ]; then
        _log "Mailbox password must not be empty"
        return 1
    fi

    local pass
    pass=$(doveadm pw -s SHA512-CRYPT -u "$login" -p "$password")
    local uid
    local gid
    uid=$(id -u "$MAIL_FS_USER")
    gid=$(id -g "$MAIL_FS_USER")

    # Replace any previous passwd-file row so changing MAIL_PASS takes effect
    # when the container is restarted.
    local userdb_file=/etc/dovecot/userdb
    local userdb_tmp=/etc/dovecot/userdb.tmp
    touch "$userdb_file"
    awk -F: -v login="$login" '$1 != login' "$userdb_file" > "$userdb_tmp"
    printf '%s:%s:%s:%s::%s/%s/%s::\n' \\
        "$login" "$pass" "$uid" "$gid" "$MAIL_FS_HOME" "$domain" "$user" \\
        >> "$userdb_tmp"
    mv "$userdb_tmp" "$userdb_file"

    local mail_domain_dir="${MAIL_LOCATION}/${domain}"
    local mail_user_dir="${mail_domain_dir}/${user}"
    if [ ! -d "$mail_domain_dir" ]; then
        mkdir -p -- "$mail_domain_dir"
        chown "$uid:$gid" "$mail_domain_dir"
    fi

    if [ ! -d "$mail_user_dir" ]; then
        maildirmake.dovecot "$mail_user_dir"
        maildirmake.dovecot "$mail_user_dir/.Sent"
        maildirmake.dovecot "$mail_user_dir/.Trash"
        maildirmake.dovecot "$mail_user_dir/.Drafts"
        printf 'INBOX\nSent\nTrash\nDrafts\n' > "$mail_user_dir/subscriptions"
        touch "$mail_user_dir/.Sent/maildirfolder"
        chown -R "$uid:$gid" "$mail_user_dir"
    fi

    if ! grep -Fqx -- "$domain" /etc/postfix/vhost; then
        printf '%s\n' "$domain" >> /etc/postfix/vhost
    fi

    local mailbox_entry="${login} ${domain}/${user}/"
    if grep -Fqx -- "$mailbox_entry" /etc/postfix/vmailbox; then
        _log "User '$login' already configured"
    else
        printf '%s\n' "$mailbox_entry" >> /etc/postfix/vmailbox
    fi
    /usr/sbin/postmap /etc/postfix/vmailbox
}

trap "_stop" SIGINT SIGTERM SIGHUP

_log "Docker entrypoint start"

# Configuring Postfix

if [ -n "$MAILNAME" ]; then
    printf '%s\n' "$MAILNAME" > /etc/mailname
    /usr/sbin/postconf -e "mydomain=$MAILNAME"
    if ! grep -Fqx -- "$MAILNAME" /etc/postfix/vhost; then
        printf '%s\n' "$MAILNAME" >> /etc/postfix/vhost
    fi
    /usr/sbin/postconf -e 'smtp_helo_name=$myhostname.$mydomain'
fi

if [ -n "$HOSTNAME" ]; then
    /usr/sbin/postconf -e "myhostname=$HOSTNAME"
fi

routes=$(ip route | grep -v default | cut -d' ' -f1)
if [ -n "$routes" ]; then
    /usr/sbin/postconf -e mynetworks="127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128 $routes"
    /usr/sbin/postconf -e inet_interfaces=all
fi

/usr/sbin/postconf -e relayhost=localhost
/usr/sbin/postconf -e mydestination=localhost
/usr/sbin/postconf -e virtual_maps='hash:/etc/postfix/virtual, regexp:/etc/postfix/virtual_regexp'
/usr/sbin/postconf -e sender_canonical_maps=regexp:/etc/postfix/sender_canonical_regexp
/usr/sbin/postconf -e virtual_transport=lmtp:unix:private/dovecot-lmtp
/usr/sbin/postconf -e mailbox_transport=lmtp:unix:private/dovecot-lmtp
/usr/sbin/postconf -e virtual_mailbox_domains=/etc/postfix/vhost
/usr/sbin/postconf -e virtual_mailbox_maps=hash:/etc/postfix/vmailbox
/usr/sbin/postconf -e compatibility_level=2

# Create user account
if [ -n "$MAIL_ADDRESS" ]; then
    if [ -z "$MAIL_PASS" ]; then
        _log "MAIL_PASS must be set when MAIL_ADDRESS is configured"
        exit 1
    fi
    _account_add "$MAIL_ADDRESS" "$MAIL_PASS"
    escaped_mail_address=$(printf '%s' "$MAIL_ADDRESS" | sed 's/[.+]/\\&/g')
    _add_line "/^${escaped_mail_address}$/ $MAIL_ADDRESS" /etc/postfix/virtual_regexp
fi

# Create debug account
_account_add "$DEBUG_ADDRESS" "$DEBUG_PASS"

# Force to send all emails to debug email address, no email to outside
_add_line "/.+@.+/ $DEBUG_ADDRESS" /etc/postfix/virtual_regexp

/usr/sbin/postmap /etc/postfix/virtual_regexp
/usr/sbin/postmap /etc/postfix/virtual
/usr/sbin/postmap /etc/postfix/vmailbox
/usr/sbin/postmap /etc/postfix/sender_canonical_regexp

# Configuring Dovecot
cp -a /usr/share/dovecot/protocols.d /etc/dovecot/
sed -i -e 's/include_try \/usr\/share\/dovecot\/protocols\.d/include_try \/etc\/dovecot\/protocols\.d/g' /etc/dovecot/dovecot.conf
sed -i -e 's/^.*postmaster_address.*/postmaster_address = '${POSTMASTER_ADDRESS}'/g' /etc/dovecot/conf.d/15-lda.conf
sed -i -e 's/^.*postmaster_address.*/  postmaster_address = '${POSTMASTER_ADDRESS}'/g' /etc/dovecot/conf.d/20-lmtp.conf


_log "Docker entrypoint configured"

# Start syslog daemon
/etc/init.d/rsyslog start

# Start Postfix daemon
/etc/init.d/postfix start

# Start Dovecot daemon
rm -rf /var/run/dovecot/master.pid
/usr/sbin/dovecot -c /etc/dovecot/dovecot.conf

"$@" & wait "$!"
